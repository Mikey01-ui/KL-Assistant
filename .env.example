# Jarvis brain — Gemini key from https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=
# Recommended for voice STT (Whisper, ~200ms). Gemini is fallback for transcription.
# https://console.groq.com
GROQ_API_KEY=

# ElevenLabs TTS (your cloned Jarvis voice)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Google Calendar + Gmail (OAuth Desktop client from Google Cloud Console)
# Enable Calendar API + Gmail API, create OAuth client type "Desktop app"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional web search (falls back to opening DuckDuckGo if unset)
# TAVILY_API_KEY=

# Optional: pin a Python interpreter for legacy Python mic STT
# PYTHON_PATH=/Users/you/.venv/bin/python
# Live voice uses browser mic + Groq Whisper. Only set this to enable voice_server.py:
# ENABLE_PYTHON_VOICE=1
